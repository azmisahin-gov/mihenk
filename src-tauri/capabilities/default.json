{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "MİHENK masaüstü penceresi için gereken sınırlı izinler.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "stronghold:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:create-app-specific-dirs",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/mihenk-vault"
        },
        {
          "path": "$APPDATA/mihenk-vault/**/*"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file"
  ]
}
